generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Platform {
  iOS
  Android
  Web
  CrossPlatform @map("Cross-platform")
}

enum FeedbackType {
  idea
  problem
  improvement
  bug
  other
}

enum FeedbackStatus {
  new
  reviewed
  linked
  closed
}

enum SenderType {
  user
  admin
  system
}

enum MessageChannel {
  in_app
  email
}

enum ConversationStatus {
  open
  closed
}

enum RequestStatus {
  review
  under_consideration
  planned
  in_progress
  released
  not_planned
}

enum RequestVisibility {
  private
  public
}

model Workspace {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  apps      App[]
  admins    AdminUser[]

  @@map("workspaces")
}

model App {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  name           String
  slug           String
  icon           String?
  platform       Platform
  status         String    @default("active")
  credentialHash String    @unique @map("credential_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  users          User[]
  feedback       Feedback[]
  conversations  Conversation[]
  requests       Request[]
  notifications  Notification[]
  changelog      ChangelogEntry[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("apps")
}

model User {
  id             String     @id @default(cuid())
  appId          String     @map("app_id")
  externalUserId String     @map("external_user_id")
  email          String?
  name           String?
  plan           String?
  locale         String?
  timezone       String?
  appVersion     String?    @map("app_version")
  osVersion      String?    @map("os_version")
  device         String?
  createdAt      DateTime   @default(now()) @map("created_at")
  lastSeenAt     DateTime   @default(now()) @map("last_seen_at")
  metadata       Json       @default("{}")
  app            App            @relation(fields: [appId], references: [id])
  feedback       Feedback[]
  conversations  Conversation[]
  votes          Vote[]
  notifications  Notification[]

  @@unique([appId, externalUserId])
  @@index([appId])
  @@map("users")
}

model Feedback {
  id                     String               @id @default(cuid())
  appId                  String               @map("app_id")
  userId                 String               @map("user_id")
  type                   FeedbackType
  title                  String?
  body                   String
  status                 FeedbackStatus       @default(new)
  source                 String               @default("in_app")
  appVersionAtSubmission String?              @map("app_version_at_submission")
  osVersionAtSubmission  String?              @map("os_version_at_submission")
  deviceAtSubmission     String?              @map("device_at_submission")
  localeAtSubmission     String?              @map("locale_at_submission")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  app                    App                  @relation(fields: [appId], references: [id])
  user                   User                 @relation(fields: [userId], references: [id])
  attachments            FeedbackAttachment[]
  conversation           Conversation?
  requestLink            FeedbackRequest?

  @@index([appId, createdAt])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("feedback")
}

model FeedbackAttachment {
  id          String   @id @default(cuid())
  feedbackId  String   @map("feedback_id")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  storageKey  String   @unique @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at")
  feedback    Feedback @relation(fields: [feedbackId], references: [id])

  @@index([feedbackId])
  @@map("feedback_attachments")
}

model Conversation {
  id         String             @id @default(cuid())
  appId      String             @map("app_id")
  userId     String             @map("user_id")
  feedbackId String             @unique @map("feedback_id")
  status     ConversationStatus @default(open)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  app        App                @relation(fields: [appId], references: [id])
  user       User               @relation(fields: [userId], references: [id])
  feedback   Feedback           @relation(fields: [feedbackId], references: [id])
  messages   Message[]

  @@index([appId, updatedAt])
  @@index([userId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
  senderType     SenderType     @map("sender_type")
  senderId       String         @map("sender_id")
  body           String
  channel        MessageChannel
  createdAt      DateTime       @default(now()) @map("created_at")
  readAt         DateTime?      @map("read_at")
  conversation   Conversation   @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Event {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  appId       String   @map("app_id")
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  type        String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([appId, createdAt])
  @@map("events")
}

model Request {
  id          String             @id @default(cuid())
  appId       String             @map("app_id")
  title       String
  description String
  status      RequestStatus      @default(review)
  visibility  RequestVisibility  @default(private)
  releasedAt  DateTime?          @map("released_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  app         App                @relation(fields: [appId], references: [id])
  links       FeedbackRequest[]
  votes       Vote[]
  updates     RequestUpdate[]
  notifications Notification[]
  changelog   ChangelogEntry?

  @@index([appId, updatedAt])
  @@index([appId, visibility, status])
  @@map("requests")
}

model FeedbackRequest {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  feedbackId String   @unique @map("feedback_id")
  createdAt  DateTime @default(now()) @map("created_at")
  request    Request  @relation(fields: [requestId], references: [id])
  feedback   Feedback @relation(fields: [feedbackId], references: [id])

  @@index([requestId])
  @@map("feedback_requests")
}

model Vote {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  request   Request  @relation(fields: [requestId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
  @@index([requestId, createdAt])
  @@map("votes")
}

model RequestUpdate {
  id          String            @id @default(cuid())
  requestId   String            @map("request_id")
  body        String
  visibility  RequestVisibility @default(public)
  createdAt   DateTime          @default(now()) @map("created_at")
  publishedAt DateTime?         @map("published_at")
  request     Request           @relation(fields: [requestId], references: [id])

  @@index([requestId, createdAt])
  @@map("request_updates")
}

model Notification {
  id        String         @id @default(cuid())
  appId     String         @map("app_id")
  userId    String         @map("user_id")
  requestId String?        @map("request_id")
  body      String
  channel   MessageChannel @default(in_app)
  createdAt DateTime       @default(now()) @map("created_at")
  readAt    DateTime?      @map("read_at")
  app       App            @relation(fields: [appId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  request   Request?       @relation(fields: [requestId], references: [id])

  @@index([userId, createdAt])
  @@index([appId, userId])
  @@map("notifications")
}

model ChangelogEntry {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  requestId   String   @unique @map("request_id")
  title       String
  body        String
  publishedAt DateTime @default(now()) @map("published_at")
  app         App      @relation(fields: [appId], references: [id])
  request     Request  @relation(fields: [requestId], references: [id])

  @@index([appId, publishedAt])
  @@map("changelog_entries")
}

model AdminUser {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         String    @default("owner")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("admin_users")
}
